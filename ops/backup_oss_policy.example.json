{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetBucketAcl",
        "oss:GetBucketPublicAccessBlock",
        "oss:GetBucketVersioning",
        "oss:GetBucketOverwriteConfig"
      ],
      "Resource": "acs:oss:*:*:REPLACE_WITH_DEDICATED_BUCKET"
    },
    {
      "Effect": "Allow",
      "Action": ["oss:PutObject", "oss:GetObject"],
      "Resource": "acs:oss:*:*:REPLACE_WITH_DEDICATED_BUCKET/database-backups/*"
    }
  ]
}
