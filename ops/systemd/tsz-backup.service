[Unit]
Description=tsz-test independent PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=/opt/tsz-rust
ExecStart=/usr/bin/python3 -I /opt/tsz-rust/ops/postgresql_backup_job.py run --config /etc/tsz-rust/backup.json
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
