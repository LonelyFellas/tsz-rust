[Unit]
Description=Report independent tsz-test backup health heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=/opt/tsz-rust
ExecStart=/opt/tsz-rust/backup-venv/bin/python -I /opt/tsz-rust/ops/backup_alert.py heartbeat /etc/tsz-rust/backup-alert.json /etc/tsz-rust/backup.json
TimeoutStartSec=2min
