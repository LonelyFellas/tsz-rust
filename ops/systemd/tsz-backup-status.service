[Unit]
Description=Check freshness of independent tsz-test backup
OnFailure=tsz-backup-alert@%n.service

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=/opt/tsz-rust
ExecStart=/usr/bin/python3 -I /opt/tsz-rust/ops/postgresql_backup_job.py status --config /etc/tsz-rust/backup.json
TimeoutStartSec=2min
