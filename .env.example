# 复制成 .env 后按需修改。config.rs 用 envy 读取，键名大小写不敏感。

# ———— 必填（缺任一项应用启动即失败）————
DATABASE_URL=postgres://postgres:postgres@localhost:5433/tsz_rust
REDIS_URL=redis://127.0.0.1:6379/0
# 生产必须换强随机值（openssl rand -base64 48），别用 dev 值
JWT_SECRET=secret

# ———— 可选（注释掉即用默认值）————
# PORT=8383
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# OTP_TTL_MINUTES=10
# OTP_COOLDOWN_SECONDS=60
# OTP_DAILY_LIMIT=10
# OTP_MAX_ATTEMPTS=5

# refresh cookie 的 Secure 标志，默认 true（只随 https 发送）。
# ⚠️ 本地开发/前面没有 TLS 的部署必须设 false，否则浏览器（Safari/非 localhost
# 的 Chrome）在 http 源丢弃 Set-Cookie → 登录成功但 refresh 永远 401 且服务端无报错。
COOKIE_SECURE=false
