# 复制成 .env 后按需修改。config.rs 用 envy 读取，键名大小写不敏感。

# ———— 必填（缺任一项应用启动即失败）————
DATABASE_URL=postgres://postgres:postgres@localhost:5433/tsz_rust
REDIS_URL=redis://127.0.0.1:6379/0
# 生产必须换强随机值（openssl rand -base64 48），别用 dev 值
JWT_SECRET=secret
# admin realm 第二把签名密钥（admin-design.md §4）：必填，且必须不同于 JWT_SECRET
#（相同则启动失败——per-realm 隔离要求密钥分离）。生产同样用 openssl rand 生成。
ADMIN_JWT_SECRET=admin-secret

# ———— 可选（注释掉即用默认值）————
# PORT=8383
# ACCESS_TTL_MINUTES=15
# REFRESH_TTL_DAYS=30
# admin access 默认 15 分钟；admin refresh 默认 7 天——注意是绝对上限非滑动（Q8），
# 轮换不续期，到期必须重新 2FA 登录。
# ADMIN_ACCESS_TTL_MINUTES=15
# ADMIN_REFRESH_TTL_DAYS=7
# OTP_TTL_MINUTES=10
# OTP_COOLDOWN_SECONDS=60
# OTP_DAILY_LIMIT=10
# OTP_MAX_ATTEMPTS=5

# refresh cookie 的 Secure 标志，默认 true（只随 https 发送）。
# ⚠️ 本地开发/前面没有 TLS 的部署必须设 false，否则浏览器（Safari/非 localhost
# 的 Chrome）在 http 源丢弃 Set-Cookie → 登录成功但 refresh 永远 401 且服务端无报错。
COOKIE_SECURE=false

# Azure TTS 默认关闭：完全不设置 AZURE_SPEECH_* 即无影响。启用时 REGION/KEY 必须同时存在；
# endpoint 由 REGION 在服务端构造，不能从环境覆盖。不要把真实 key 提交到仓库。
# AZURE_SPEECH_ENABLED=true
# AZURE_SPEECH_REGION=eastasia
# AZURE_SPEECH_KEY=replace-with-secret-manager-value
# AZURE_SPEECH_CONNECT_TIMEOUT_MS=3000
# AZURE_SPEECH_REQUEST_TIMEOUT_MS=15000
# AZURE_SPEECH_MAX_RESPONSE_BYTES=5242880
