# Copy this file to .env.production and fill in the required values locally.
# Keep .env.production out of Git.

# Required by PostgreSQL and DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://postgres:@db:5432/tsz_rust
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
ADMIN_JWT_SECRET=

COOKIE_SECURE=true
PORT=8383
BIND_IP=0.0.0.0
