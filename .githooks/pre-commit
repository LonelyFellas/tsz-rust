#!/bin/sh
# 规则文档不需要数据库/编译检查；SQLx 仅随查询或构建输入变化刷新。
# 其他提交保留 Clippy；无法判断变更范围时执行完整门禁。
set -e

check_scope=$(python3 - <<'PY_SCOPE'
import subprocess

paths = subprocess.check_output(
    ["git", "diff", "--cached", "--name-only", "--no-renames", "-z"]
).split(b"\0")[:-1]
rule_doc = lambda path: path == b"AGENTS.md" or (
    path.startswith((b".agents/skills/", b".claude/skills/"))
    and path.endswith(b".md")
)
sqlx_input = lambda path: (
    path.endswith((b".rs", b".sql"))
    or path.rsplit(b"/", 1)[-1] in (b"Cargo.toml", b"Cargo.lock", b"rust-toolchain", b"rust-toolchain.toml")
    or path.startswith((b".cargo/", b"migrations/"))
)
print("docs" if paths and all(map(rule_doc, paths)) else
      "sqlx" if not paths or any(map(sqlx_input, paths)) else "clippy")
PY_SCOPE
) || check_scope=sqlx

if [ "$check_scope" = docs ]; then
    echo "▶ pre-commit: 仅规则文档，无需 SQLx/Clippy 检查"
    exit 0
fi

if [ "$check_scope" = sqlx ]; then
    echo "▶ pre-commit: cargo sqlx prepare -- --all-targets --all-features"
    cargo sqlx prepare -- --all-targets --all-features
    git add -A .sqlx
fi

echo "▶ pre-commit: cargo clippy --all-targets --all-features -- -D warnings"
cargo clippy --all-targets --all-features -- -D warnings
