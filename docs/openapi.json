{"openapi":"3.1.0","info":{"title":"tsz-rust API","description":"tsz 核心服务（Rust 版）接口文档","license":{"name":""},"version":"0.1.0"},"paths":{"/api/v1/admin/auth/login":{"post":{"tags":["admin"],"summary":"POST /api/v1/admin/auth/login","description":"admin 登录须**三要素齐全**：手机号 + 密码 + 短信验证码（先调 `login-code` 取码）。\n失败一律压成逐字节一致的 401（密码错 / 码错 / 查无此号不可区分，反枚举）；\n禁用 403、锁定 423、验证码基础设施抖动 503 是仅有的可区分分支。","operationId":"admin_login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminLoginRequest"}}},"required":true},"responses":{"200":{"description":"登录成功，返回管理员档案与令牌","headers":{"Set-Cookie":{"schema":{"type":"string"},"description":"admin_refresh_token cookie（HttpOnly; SameSite=Lax; Path=/api/v1/admin/auth; Max-Age=refresh TTL 秒）"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminLoginResponse"}}}},"400":{"description":"手机号格式非法"},"401":{"description":"凭证无效（密码/验证码错误或账号不存在，逐字节不可区分）"},"403":{"description":"账号被禁用"},"423":{"description":"账号因多次登录失败被临时锁定"},"429":{"description":"验证码请求过于频繁"},"503":{"description":"验证码基础设施不可用（Redis/短信）"}}}},"/api/v1/admin/auth/login-code":{"post":{"tags":["admin"],"summary":"POST /api/v1/admin/auth/login-code","description":"返回类型刻意钉成具体的 `StatusCode`（而非 `impl IntoResponse`）：本端点的反枚举契约\n是「一切非基础设施结果恒返 202 空 body」，具体类型让「某分支误返 Json(..) 破坏该契约」\n变成编译错误。","operationId":"admin_login_code","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminLoginOtpRequest"}}},"required":true},"responses":{"202":{"description":"已受理（反枚举：查无此号/禁用/锁定/冷却中一律 202 空 body，仅 active admin 真正发码）"},"400":{"description":"手机号格式非法"},"503":{"description":"验证码基础设施不可用（Redis/短信）"}}}},"/api/v1/admin/auth/logout":{"post":{"tags":["admin"],"summary":"POST /api/v1/admin/auth/logout\n幂等登出（对齐 RFC 7009 语义）：cookie 缺失 = 已处于登出态，目标已达成。\n有枚就吊销；无论有没有，都下发清除 cookie 并返回 204。","operationId":"admin_logout","parameters":[{"name":"admin_refresh_token","in":"cookie","description":"要吊销的 admin refresh token；缺失时仍 204（幂等）","required":false,"schema":{"type":["string","null"]}}],"responses":{"204":{"description":"登出成功（幂等，无失败分支）；带 cookie 时附清除 Set-Cookie","headers":{"Set-Cookie":{"schema":{"type":"string"},"description":"清除 admin_refresh_token 的 cookie（Max-Age=0）"}}}}}},"/api/v1/admin/auth/refresh":{"post":{"tags":["admin"],"summary":"POST /api/v1/admin/auth/refresh","description":"用 admin_refresh_token cookie 轮换会话：签发新 access token，并经 Set-Cookie\n下发轮换出的新 refresh token（继承旧枚绝对死线，Q8 不续命）。旧枚原子消费作废；\n窗口外重放会连坐吊销该 admin 全部会话。","operationId":"admin_refresh","parameters":[{"name":"admin_refresh_token","in":"cookie","description":"登录时经 Set-Cookie 下发的 admin refresh token，浏览器自动携带（HttpOnly；Path=/api/v1/admin/auth，仅认证端点可见）","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"轮换成功，返回新 access token；新 refresh token 经 Set-Cookie 下发","headers":{"Set-Cookie":{"schema":{"type":"string"},"description":"轮换出的新 admin_refresh_token cookie"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminRefreshResponse"}}}},"401":{"description":"refresh token 缺失、无效、已过期或重放"},"403":{"description":"账号被禁用"},"423":{"description":"账号被临时锁定"}}}},"/api/v1/admin/profile":{"get":{"tags":["admin"],"summary":"GET /api/v1/admin/profile","description":"登录管理员自身档案（/me 型身份探针）：前端用它确认会话有效、渲染顶栏与侧栏菜单。\n刻意**不查** locked_until——锁定语义只挡新登录/refresh 轮换（防爆破），不打断\n已认证的短命 access token，否则错码轰炸可把在线管理员打下线（DoS）。","operationId":"admin_profile","responses":{"200":{"description":"登录管理员完整档案","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminProfileResponse"}}}},"401":{"description":"缺/无效/过期 token，或账号已不存在（视为过期会话）"},"403":{"description":"账号已禁用（无 code）；或须先改密（code=must_change_password，前端据此跳改密页）"}},"security":[{"bearer_auth":[]}]}},"/api/v1/auth/login":{"post":{"tags":["auth"],"summary":"POST /api/v1/auth/login","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"登录成功，返回用户信息与令牌","headers":{"Set-Cookie":{"schema":{"type":"string"},"description":"refresh_token cookie（HttpOnly; SameSite=Lax; Path=/api/v1/auth; Max-Age=refresh TTL 秒）"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"401":{"description":"凭证无效（用户不存在或密码错误，不可区分）"},"403":{"description":"账号被禁用"}}}},"/api/v1/auth/login-otp":{"post":{"tags":["auth"],"summary":"POST /api/v1/auth/login-otp","operationId":"login_otp","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginOtpRequest"}}},"required":true},"responses":{"200":{"description":"验证码登录成功，返回用户信息与令牌","headers":{"Set-Cookie":{"schema":{"type":"string"},"description":"refresh_token cookie（HttpOnly; SameSite=Lax; Path=/api/v1/auth; Max-Age=refresh TTL 秒）"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"401":{"description":"验证码无效或已过期"},"429":{"description":"请求过于频繁"}}}},"/api/v1/auth/logout":{"post":{"tags":["auth"],"summary":"POST /api/v1/auth/logout","operationId":"logout","parameters":[{"name":"refresh_token","in":"cookie","description":"要吊销的 refresh token；缺失时仍 204（幂等）","required":false,"schema":{"type":["string","null"]}}],"responses":{"204":{"description":"登出成功（幂等，无失败分支）；带 cookie 时附清除 Set-Cookie","headers":{"Set-Cookie":{"schema":{"type":"string"},"description":"清除 refresh_token 的 cookie（Max-Age=0）"}}}}}},"/api/v1/auth/me":{"get":{"tags":["auth"],"summary":"GET /api/v1/auth/me","operationId":"me","responses":{"200":{"description":"当前登录用户信息","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserProfile"}}}},"401":{"description":"未认证 / token 无效或过期"}},"security":[{"bearer_auth":[]}]}},"/api/v1/auth/refresh":{"post":{"tags":["auth"],"summary":"POST /api/v1/auth/refresh","operationId":"refresh_token","parameters":[{"name":"refresh_token","in":"cookie","description":"登录时经 Set-Cookie 下发的 refresh token，浏览器自动携带（HttpOnly，手动调用需自带 Cookie 头）","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"轮换成功，返回新 access token；新 refresh token 经 Set-Cookie 下发","headers":{"Set-Cookie":{"schema":{"type":"string"},"description":"轮换出的新 refresh_token cookie"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshResponse"}}}},"401":{"description":"refresh token 缺失、无效、已过期或用户被禁用"}}}},"/api/v1/otp/send":{"post":{"tags":["otp"],"summary":"POST /api/v1/otp/send","operationId":"send_otp","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SendOtpRequest"}}},"required":true},"responses":{"202":{"description":"验证码已受理并发送"},"400":{"description":"手机号与邮箱须且仅须提供一个"},"429":{"description":"请求过于频繁（冷却期内或超日限）"},"503":{"description":"存储或发送上游不可用（fail-close）"}}}},"/api/v1/user/register":{"post":{"tags":["user"],"summary":"POST /api/v1/user/register","operationId":"register","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterRequest"}}},"required":true},"responses":{"201":{"description":"注册成功","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterResponse"}}}},"400":{"description":"手机号/邮箱缺失或密码格式不合法"},"409":{"description":"手机号或邮箱已被占用"}}}}},"components":{"schemas":{"AdminLoginOtpRequest":{"type":"object","required":["phone"],"properties":{"phone":{"type":"string","description":"登录标识：手机号","example":"13800138000"}}},"AdminLoginRequest":{"type":"object","required":["phone","code","password"],"properties":{"code":{"type":"string","description":"短信验证码（6 位；`login-code` 端点发出）","example":"123456"},"password":{"type":"string","description":"登录密码","example":"password123"},"phone":{"type":"string","description":"登录标识：手机号","example":"13800138000"}}},"AdminLoginResponse":{"allOf":[{"$ref":"#/components/schemas/AdminToken"},{"type":"object","required":["admin_profile","refresh_token_expires_at"],"properties":{"admin_profile":{"$ref":"#/components/schemas/AdminProfile"},"refresh_token_expires_at":{"type":"integer","format":"int64","description":"refresh token 过期时间（Unix 秒，绝对时间戳，与落