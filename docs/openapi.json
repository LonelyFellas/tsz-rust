pe":"object","required":["user","refresh_token_expires_at"],"properties":{"refresh_token_expires_at":{"type":"integer","format":"int64","description":"refresh token 过期时间（Unix 秒，绝对时间戳，与落库那枚一致）","example":1752566400},"user":{"$ref":"#/components/schemas/UserProfile"}}}]},"PublicOtpPurpose":{"type":"string","enum":["login","password_reset","account_deletion","contact_bind"]},"Purpose":{"type":"string","enum":["login","admin_login","admin_create","password_reset","account_deletion","contact_bind"],"example":"login"},"RefreshResponse":{"allOf":[{"$ref":"#/components/schemas/Token"},{"type":"object","required":["refresh_token_expires_at"],"properties":{"refresh_token_expires_at":{"type":"integer","format":"int64","description":"refresh token 过期时间（Unix 秒，绝对时间戳，与轮换出的新枚落库值一致）","example":1752566400}}}]},"RegisterRequest":{"type":"object","description":"DTO","required":["password"],"properties":{"email":{"type":["string","null"],"description":"邮箱（与 phone 二选一）","example":"student@example.com"},"password":{"type":"string","example":"P@ssw0rd!"},"phone":{"type":["string","null"],"description":"手机号（与 email 二选一）","example":"13800138000"}}},"RegisterResponse":{"type":"object","required":["user_id","display_name","role"],"properties":{"display_name":{"type":"string","example":"同学1234"},"role":{"type":"string","example":"student"},"user_id":{"type":"string","example":"0198f2a1-3b4c-7d5e-8f90-1a2b3c4d5e6f"}}},"SendOtpRequest":{"type":"object","required":["purpose"],"properties":{"email":{"type":["string","null"],"description":"邮箱（与 phone 二选一，恰好提供一个）"},"phone":{"type":["string","null"],"description":"手机号（与 email 二选一，恰好提供一个）","example":"13800138000"},"purpose":{"$ref":"#/components/schemas/PublicOtpPurpose"}}},"Token":{"type":"object","required":["access_token","expires_in"],"properties":{"access_token":{"type":"string","example":"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIwMTk4Zi4uLiJ9.sig"},"expires_in":{"type":"integer","format":"int64","description":"access token 有效期（秒）","example":900}}},"UserP