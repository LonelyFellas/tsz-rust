dRequest"}}},"required":true},"responses":{"204":{"description":"密码修改成功，must_change_password 标志已清除"},"400":{"description":"新旧密码相同，或新密码不符合管理员密码策略","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetails"}}}},"401":{"description":"缺少/无效/过期 token，账号不存在，或当前密码错误","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetails"}}}}},"security":[{"bearer_auth":[]}]}},"/api/v1/admin/auth/login":{"post":{"tags":["admin"],"summary":"POST /api/v1/admin/auth/login","description":"admin 登录须**三要素齐全**：手机号 + 密码 + 短信验证码（先调 `login-code` 取码）。\n失败一律压成逐字节一致的 401（密码错 / 码错 / 查无此号不可区分，反枚举）；\n禁用 403、锁定 423、验证码基础设施抖动 503 是仅有的可区分分支。","operationId":"admin_login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminLoginRequest"}}},"required":true},"responses":{"200":{"description":"登录成功，返回管理员档案与令牌","headers":{"Set-Cookie":{"schema":{"type":"string"},"description":"admin_refresh_token cookie（HttpOnly; SameSite=Lax; Path=/api/v1/admin/auth; Max-Age=refresh TTL 秒）"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminLoginResponse"}}}},"400":{"description":"手机号格式非法","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetails"}}}},"401":{"description":"凭证无效（密码/验证码错误或账号不存在，逐字节不可区分）","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetails"}}}},"403":{"description":"账号被禁用","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetails"}}}},"423":{"description":"账号因多次登录失败被临时锁定","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetails"}}}},"429":{"description":"验证码请求过于频繁","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetails"}}}},"503":{"description":"验证码基础设施不可用（Redis/短信）","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetails"}}}}}}},"/api/v1/admin/auth/login-code":{"post":{"tags":["admin"],"summary":"POST /api/v1/admin/auth/login-code","description":"返回类型刻意钉成具体的 `StatusCode`（而非 `impl IntoResponse`）：本端点的反枚举契约\n是「一切非基础设施结果恒返 202 空 body」，具体类型让「某分支误返 Json(..) 破坏该契约」\n变成编译错误。","operationId":"admin_login_code","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminLoginOtpRequest"}}},"required":true},"responses":{"202":{"description":"已受理（反枚举：查无此号/禁用/锁定/冷却中一律 202 空 body，仅 active admin 真正发码）"},"400":{"description":"手机号格式非法","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetails"}}}},"503":{"description":"验证码基础设施不可用（Redis/短信）","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemDetails"}}}}}}},"/api/v1/admin/auth/logout":{"post":{"tags":["admin"],"summary":"POST /api/v1/admin/auth/logout\n幂等登出（对齐 RFC 7009 语义）：cookie 缺失 = 已处于登出态，目标已达成。\n有枚就吊销；无论有没有，都下发清除 cookie 并返回 204。","operationId":"admin_logout","parameters":[{"name":"admin_refresh_token","in":"cookie","description":"要吊销的 admin refresh token；缺失时仍 204（幂等）","required":false,"schema":{"type":["string","null"]}}],"responses":{"204":{"description":"登出成功（幂等，无失败分支）；带 cookie 时附清除 Set-Cookie","headers":{"Set-Cookie":{"schema":{"type":"string"},"description":"清除 admin_refresh_token 的 cookie（Max-Age=0）"}}}}}},"/api/v1/admin/auth/refresh":{"post":{"tags":["admin"],"summary":"POST /api/v1/admin/auth/refresh","description":"用 admin_refresh_token cookie 轮换会话：签发新 access token，并经 Set-Cookie\n下发轮换出的新 refresh token（继承旧枚绝对死线，Q8 不续命）。旧枚原子消费作废；\n窗口外重放会连坐吊销该 admin 全部会话。","operationId":"admin_refresh","parameters":[{"name":"admin_refresh_token","in":"cookie","description":"登录时经 Set-Cookie 下发的 admin refresh token，浏览器自动携带（HttpOnly；Path=/api/v1/admin/auth，仅认证端点可见）","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"轮换成功，返回新 access token；新 refresh token 经 Set-Cookie 下发","headers":{"Set-Cookie":{"schema":{"type":"string"},"description":"轮换出的新 admin_refresh_token cookie"}},"conte